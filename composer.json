{
    "name": "eloquage/vector",
    "description": "In-process vector math for PHP: cosine, dot, L2, top-k, and batch similarity with a pure-PHP API and optional native acceleration.",
    "keywords": [
        "Eloquage",
        "vector"
    ],
    "homepage": "https://github.com/eloquage/vector",
    "license": "MIT",
    "authors": [
        {
            "name": "Miguel Enes",
            "email": "carlos.miguel.enes@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^5.2",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Eloquage\\Vector\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eloquage\\Vector\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
